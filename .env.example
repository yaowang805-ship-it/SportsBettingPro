# SportsBettingPro 本地私密配置示例
# 复制本文件为 .env，并填写真实密钥

# 通用赔率 API Key（the-odds-api.com，免费500次/月）
ODDS_API_KEY=your_odds_api_key

# 备用赔率 API Key（多个可自动轮转）
ODDS_API_KEY_2=
ODDS_API_KEY_3=

# Free-tier Odds-API.io（100次/小时，免费注册 https://odds-api.io）
ODDS_API_IO_KEY=

# 单独指定足球/篮球 API Key（可选）
FOOTBALL_API_KEY=your_football_api_key
BASKETBALL_API_KEY=your_basketball_api_key

# 其他 API Key
BDL_API_KEY=your_bdl_api_key

# 钉钉通知 Webhook
DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=YOUR_TOKEN

# 资金管理参数
DEFAULT_BUDGET=1000
MAX_SINGLE_BET_PCT=0.05
MAX_TOTAL_EXPOSURE=0.30
KELLY_FRACTION=0.25
MIN_EDGE=0.06

# API 请求超时时间（秒）
SPORTS_API_TIMEOUT=15

# ===== 自动下注执行（可选） =====
# 平台: selenium | betfair
BETTING_PLATFORM=selenium

# Betfair Exchange API
BETFAIR_API_KEY=
BETFAIR_USERNAME=
BETFAIR_PASSWORD=
BETFAIR_CERT_PATH=

# Selenium自动化下注（中国平台）
SELENIUM_DRIVER_PATH=/usr/local/bin/chromedriver
SELENIUM_HEADLESS=true
SELENIUM_PLATFORM_URL=
SELENIUM_PLATFORM_USERNAME=
SELENIUM_PLATFORM_PASSWORD=

# RACE Odds API（活盘验证）
RACE_API_KEY=

# 下注前活盘验证
PRE_BET_ODDS_VALIDATION=true
MAX_ODDS_SLIPPAGE=0.05
