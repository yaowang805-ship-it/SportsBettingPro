# SportsBettingPro 本地私密配置示例
# 复制本文件为 .env，并填写真实密钥

# 通用赔率 API Key（the-odds-api.com，免费500次/月）
ODDS_API_KEY=your_odds_api_key

# 备用赔率 API Key（多个可自动轮转）
ODDS_API_KEY_2=
ODDS_API_KEY_3=

# 足球赛果 API Key（football-data.org）
FOOTBALL_API_KEY=your_football_api_key

# 棒球比分 API Key
BSD_API_KEY=your_bsd_api_key

# 篮球比分 API Key
BALLDONTLIE_API_KEY=your_balldontlie_api_key

# BB体育 API Token（api.infv1.com）
BB_API_TOKEN=your_bb_api_token

# 钉钉通知 Webhook
DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=YOUR_TOKEN

# PostgreSQL 数据库 URL（留空使用 SQLite）
DATABASE_URL=

# 资金管理参数
DEFAULT_BUDGET=50000
MAX_SINGLE_BET_PCT=0.06
MAX_TOTAL_EXPOSURE=0.30

# 下注前活盘验证
PRE_BET_ODDS_VALIDATION=true
MAX_ODDS_SLIPPAGE=0.05
